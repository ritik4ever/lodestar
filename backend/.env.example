# Required: Contract ID of the main registry contract. Obtain it after deploying the contract to your target network.
CONTRACT_ID=dummy_contract_id
# Required: Public key of the backend server wallet used to sign Stellar transactions. Obtain it from the Stellar account you create for the backend service.
SERVER_STELLAR_ADDRESS=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Required: Secret key for the backend server wallet. Obtain it from the same Stellar account you create for the backend service and keep it private.
SERVER_STELLAR_SECRET=SAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Required: Horizon RPC endpoint for the Stellar network you are using. Use the public testnet/mainnet URL or your own RPC provider.
STELLAR_RPC_URL=https://horizon-testnet.stellar.org
# Required: Network passphrase for the Stellar network. Use the default testnet passphrase unless you are running a custom network.
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Required: Base URL of the facilitator service that the backend calls. Obtain it from your facilitator deployment or use the local default for development.
FACILITATOR_URL=http://localhost
# Required: Contract ID of the USDC asset on the active network. Obtain it from the deployed asset contract or the network's contract registry.
USDC_CONTRACT_ID=dummy_usdc_contract
# Optional: Runtime environment name. Safe default: test.
NODE_ENV=test
# Optional: Port for the backend HTTP server. Safe default: 3001.
PORT=3001
# Optional: Logging verbosity. Safe default: info.
LOG_LEVEL=info
# Required: Contract ID of the agents contract. Obtain it after deploying the agents contract to your target network.
AGENTS_CONTRACT_ID=dummy_agents_contract_id
# Optional: Grace period for shutdown handling in milliseconds. Safe default: 35000.
SHUTDOWN_TIMEOUT_MS=35000

# Comma-separated list of allowed CORS origins. Required when NODE_ENV=production
# (startup fails otherwise) since CORS is mounted with credentials: true, and "*"
# is always rejected. Falls back to http://localhost:3000 outside production.
# CORS_ORIGIN=https://your-frontend.example.com

# --- Contract-error tuning (optional) ---------------------------------------
# Timeouts, retry counts and TTLs that were once hardcoded in the backend.
# Defaults below preserve the original behaviour; override to tune without a
# code change. Effective values are logged at startup (and via `--print-config`).
# RPC request timeout in seconds applied to built Soroban transactions. Default: 30.
# RPC_TIMEOUT_SECONDS=30
# How long a prepared registry submission token stays valid before pruning. Default: 600000 (10 min).
# REGISTRY_SUBMIT_TOKEN_TTL_MS=600000
# Re-fetch the account sequence number when the last sync is older than this. Default: 5000.
# SEQ_NUM_SYNC_INTERVAL_MS=5000
# Max retries for txBAD_SEQ before surfacing TransactionFailedError. Default: 3.
# BAD_SEQ_MAX_RETRIES=3
# Max times to poll getTransaction for confirmation before TRANSACTION_TIMEOUT. Default: 20.
# TRANSACTION_POLL_MAX_ATTEMPTS=20
# Delay between NOT_FOUND poll attempts while waiting for confirmation. Default: 1500.
# TRANSACTION_POLL_DELAY_MS=1500
# Idempotency store TTL in milliseconds (payment route replay window). Default: 86400000 (24 h).
# IDEMPOTENCY_TTL_MS=86400000
# How often expired idempotency keys are swept from the store. Default: 60000.
# IDEMPOTENCY_PURGE_INTERVAL_MS=60000
