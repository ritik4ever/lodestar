# Required: Secret key for the agent wallet. Obtain it from the Stellar account created for the agent and keep it private.
AGENT_STELLAR_SECRET=your_agent_secret_key
# Optional: Stellar network name for the agent. Safe default: testnet.
STELLAR_NETWORK=testnet
# Required: Soroban RPC URL for the selected network. Use the public testnet URL or your own RPC provider.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Required: Network passphrase for the selected Stellar network. Use the default testnet passphrase unless you are on a custom network.
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Required: Base URL of the Lodestar backend API that the agent should call. Use your local backend URL or the deployed backend URL.
LODESTAR_API_URL=http://localhost:3001
# Required: HMAC secret used to sign payment-record requests. Obtain it from the shared backend secret configuration, and ensure it matches the backend setting.
# REQUIRED in production (NODE_ENV=production) — the agent will refuse to start without it.
# In development/test a warning is logged when this is absent, but the agent will still run.
LODESTAR_HMAC_SECRET=your_server_secret_key

# Optional: Display name for the agent in logs and on-chain registration. Safe default: LodestarAgent.
AGENT_NAME=LodestarAgent
# Optional: Human-readable description for the agent. Safe default: Autonomous x402 agent powered by Lodestar service discovery.
AGENT_DESC=Autonomous x402 agent powered by Lodestar service discovery

# Optional: Maximum payment amount per transaction. Safe default: 0.001.
AGENT_MAX_PER_TX=0.001
# Optional: Maximum payment amount per day. Safe default: 1.00.
AGENT_MAX_PER_DAY=1.00

# Optional: Comma-separated categories the agent is allowed to serve. Safe default: weather,search.
AGENT_ALLOWED_CATEGORIES=weather,search

# Service selection hardening
# Optional: Minimum service reputation required for payment eligibility. Safe default: 0.
AGENT_MIN_SERVICE_REPUTATION=0
# Optional: Maximum number of service candidates to consider and retry attempts per task. Safe default: 3.
AGENT_MAX_SERVICE_RETRIES=3
