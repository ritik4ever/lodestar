# Optional: Canonical site URL used by sitemap.xml and robots.txt. Set it to your deployed frontend URL for production.
NEXT_PUBLIC_SITE_URL=https://lodestar.app

# Required: Base URL of the Lodestar backend API that the frontend should call. Use your local backend URL or your deployed backend URL.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Required: Contract ID of the deployed registry contract. Obtain it after deploying the contract to your target network.
NEXT_PUBLIC_CONTRACT_ID=your_deployed_registry_contract_id_here

# Optional: Contract ID of the LodestarAgents on-chain program. Set this only if the frontend needs direct browser-to-contract agent calls.
# Obtain it from the deployed agents contract, and ensure it matches the backend AGENTS_CONTRACT_ID value.
NEXT_PUBLIC_AGENTS_CONTRACT_ID=your_deployed_agents_contract_id_here

# Optional: Public key of the demo agent used for reputation votes. Obtain it from the Stellar account you have configured as the demo agent.
NEXT_PUBLIC_DEMO_AGENT_ADDRESS=your_demo_agent_public_key_here
# Optional: Stellar network name used by the frontend. Safe default: testnet.
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Optional: Soroban RPC URL used by the frontend. Safe default: https://soroban-testnet.stellar.org.
NEXT_PUBLIC_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Optional: Explorer URL for the selected network. Safe default for testnet: https://stellar.expert/explorer/testnet.
NEXT_PUBLIC_EXPLORER_URL=https://stellar.expert/explorer/testnet
# Optional: Horizon URL for the selected network. Safe default for testnet: https://horizon-testnet.stellar.org.
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
